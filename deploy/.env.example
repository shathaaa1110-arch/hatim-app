# Copy to deploy/.env.local and fill locally. Never commit credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/hatim?sslmode=require
# Empty when web + API share the same HTTPS origin.
HATIM_CORS_ORIGINS=
HATIM_HTTP_PORT=8000
# Optional, server-only. Verified real places and Google project quotas required.
GOOGLE_PLACES_API_KEY=
