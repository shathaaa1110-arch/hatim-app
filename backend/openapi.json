{
  "openapi": "3.1.1",
  "info": {
    "title": "Hatim API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "Api"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {}
            }
          }
        }
      }
    },
    "/api/experiences": {
      "get": {
        "tags": [
          "Api"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Experience"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/groups": {
      "post": {
        "tags": [
          "Api"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateGroup"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateGroup"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CreateGroup"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GroupCreated"
                }
              }
            }
          }
        }
      }
    },
    "/api/groups/{group_id}": {
      "get": {
        "tags": [
          "Api"
        ],
        "parameters": [
          {
            "name": "group_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GroupView"
                }
              }
            }
          }
        }
      }
    },
    "/api/groups/{group_id}/settings": {
      "put": {
        "tags": [
          "Api"
        ],
        "parameters": [
          {
            "name": "group_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Settings"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/Settings"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/Settings"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GroupView"
                }
              }
            }
          }
        }
      }
    },
    "/api/groups/{group_id}/profile": {
      "put": {
        "tags": [
          "Api"
        ],
        "parameters": [
          {
            "name": "group_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Preferences"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/Preferences"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/Preferences"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GroupView"
                }
              }
            }
          }
        }
      }
    },
    "/api/groups/{group_id}/members/{member_id}": {
      "delete": {
        "tags": [
          "Api"
        ],
        "parameters": [
          {
            "name": "group_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "member_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GroupView"
                }
              }
            }
          }
        }
      }
    },
    "/api/invites/{code}": {
      "get": {
        "tags": [
          "Api"
        ],
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InviteView"
                }
              }
            }
          }
        }
      }
    },
    "/api/invites/{code}/members": {
      "post": {
        "tags": [
          "Api"
        ],
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Preferences"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/Preferences"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/Preferences"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberCreated"
                }
              }
            }
          }
        }
      }
    },
    "/api/invites/{code}/me": {
      "get": {
        "tags": [
          "Api"
        ],
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Member"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Api"
        ],
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Preferences"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/Preferences"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/Preferences"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Member"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Allergen": {
        "enum": [
          "مكسرات",
          "فول سوداني",
          "حليب",
          "قمح",
          "سمسم",
          "قشريات",
          "سمك",
          "بيض",
          "صويا"
        ]
      },
      "Category": {
        "enum": [
          "مطابخ جديدة",
          "كنوز مخفية",
          "افتتاحات",
          "طبق ولحظة"
        ]
      },
      "CreateGroup": {
        "required": [
          "preferences"
        ],
        "type": "object",
        "properties": {
          "title": {
            "maxLength": 60,
            "minLength": 1,
            "type": "string",
            "default": "لَمّتنا في الرياض"
          },
          "preferences": {
            "$ref": "#/components/schemas/Preferences"
          }
        },
        "additionalProperties": false
      },
      "Cuisine": {
        "enum": [
          "سعودي",
          "ياباني",
          "إيطالي",
          "شامي",
          "آسيوي",
          "قهوة وحلى"
        ]
      },
      "Decision": {
        "required": [
          "experience_id",
          "priority",
          "reason",
          "adaptations",
          "score"
        ],
        "type": "object",
        "properties": {
          "experience_id": {
            "type": "string"
          },
          "priority": {
            "$ref": "#/components/schemas/Priority"
          },
          "reason": {
            "type": "string"
          },
          "adaptations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "score": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "Experience": {
        "required": [
          "id",
          "title",
          "venue",
          "neighborhood",
          "category",
          "cuisine",
          "description",
          "why",
          "image",
          "price",
          "minutes",
          "editorial"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "venue": {
            "type": "string"
          },
          "neighborhood": {
            "type": "string"
          },
          "category": {
            "$ref": "#/components/schemas/Category"
          },
          "cuisine": {
            "$ref": "#/components/schemas/Cuisine"
          },
          "description": {
            "type": "string"
          },
          "why": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "price": {
            "type": "integer",
            "format": "int32"
          },
          "minutes": {
            "type": "integer",
            "format": "int32"
          },
          "editorial": {
            "type": "integer",
            "format": "int32"
          },
          "vegetarian": {
            "type": "boolean"
          },
          "vegetarian_option": {
            "type": [
              "null",
              "string"
            ]
          },
          "spicy": {
            "type": "boolean"
          },
          "mild_option": {
            "type": [
              "null",
              "string"
            ]
          },
          "allergens": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Allergen"
            }
          },
          "verified_free_of": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Allergen"
            }
          }
        },
        "additionalProperties": false
      },
      "GroupCreated": {
        "required": [
          "organizer_token",
          "group"
        ],
        "type": "object",
        "properties": {
          "organizer_token": {
            "type": "string"
          },
          "group": {
            "$ref": "#/components/schemas/GroupView"
          }
        },
        "additionalProperties": false
      },
      "GroupView": {
        "required": [
          "id",
          "title",
          "invite_code",
          "settings",
          "members",
          "plan"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "invite_code": {
            "type": "string"
          },
          "settings": {
            "$ref": "#/components/schemas/Settings"
          },
          "members": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Member"
            }
          },
          "plan": {
            "$ref": "#/components/schemas/Plan"
          }
        },
        "additionalProperties": false
      },
      "InviteView": {
        "required": [
          "title",
          "member_names",
          "slots",
          "selected",
          "anchor_issue",
          "consumed"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "member_names": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "slots": {
            "type": "integer",
            "format": "int32"
          },
          "selected": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Decision"
            }
          },
          "anchor_issue": {
            "type": [
              "null",
              "string"
            ]
          },
          "consumed": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "Member": {
        "required": [
          "id",
          "preferences"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "preferences": {
            "$ref": "#/components/schemas/Preferences"
          },
          "organizer": {
            "type": "boolean",
            "default": false
          }
        },
        "additionalProperties": false
      },
      "MemberCreated": {
        "required": [
          "member_token",
          "member"
        ],
        "type": "object",
        "properties": {
          "member_token": {
            "type": "string"
          },
          "member": {
            "$ref": "#/components/schemas/Member"
          }
        },
        "additionalProperties": false
      },
      "Plan": {
        "required": [
          "selected",
          "pocket",
          "anchor_issue",
          "consumed",
          "available",
          "unfilled"
        ],
        "type": "object",
        "properties": {
          "selected": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Decision"
            }
          },
          "pocket": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PocketItem"
            }
          },
          "anchor_issue": {
            "type": [
              "null",
              "string"
            ]
          },
          "consumed": {
            "type": "integer",
            "format": "int32"
          },
          "available": {
            "type": "integer",
            "format": "int32"
          },
          "unfilled": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "PocketItem": {
        "required": [
          "experience_id",
          "reason"
        ],
        "type": "object",
        "properties": {
          "experience_id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "blocked": {
            "type": "boolean",
            "default": false
          }
        },
        "additionalProperties": false
      },
      "Preferences": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 30,
            "minLength": 1,
            "type": "string"
          },
          "role": {
            "default": "مقيم",
            "$ref": "#/components/schemas/Role"
          },
          "cuisines": {
            "maxItems": 6,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Cuisine"
            }
          },
          "allergies": {
            "maxItems": 9,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Allergen"
            }
          },
          "vegetarian": {
            "type": "boolean"
          },
          "mild": {
            "type": "boolean"
          },
          "budget": {
            "maximum": 500,
            "minimum": 30,
            "type": "integer",
            "format": "int32",
            "default": 200
          }
        },
        "additionalProperties": false
      },
      "Priority": {
        "enum": [
          "ركيزة",
          "أساسية",
          "مرنة"
        ]
      },
      "Role": {
        "enum": [
          "مقيم",
          "زائر"
        ]
      },
      "Settings": {
        "type": "object",
        "properties": {
          "slots": {
            "maximum": 9,
            "minimum": 1,
            "type": "integer",
            "format": "int32",
            "default": 9
          },
          "anchor_id": {
            "type": [
              "null",
              "string"
            ],
            "default": "fire"
          },
          "pocket_ids": {
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "completed_ids": {
            "maxItems": 9,
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "tags": [
    {
      "name": "Api"
    }
  ]
}
